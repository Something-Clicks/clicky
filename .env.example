# Something Clicks environment variables.
# Copy to .env.local for local work. Never commit real values.
# On Vercel: Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are sent to the browser; everything else stays on the server.

# Site
NEXT_PUBLIC_SITE_URL=

# Supabase (public values: the publishable key only grants what RLS allows)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Server-only secrets (never NEXT_PUBLIC_) ──
# Claude API: Action Card wording and AI drafts. Without it, cards use template wording and drafting is off.
ANTHROPIC_API_KEY=
# Google PageSpeed Insights API key (free). Without it Google's shared quota is often exhausted.
PAGESPEED_API_KEY=
# Weekly re-analysis worker (Vercel Cron). Secret key from Supabase → Project Settings → API Keys.
SUPABASE_SECRET_KEY=
# Long random string (openssl rand -hex 32). Vercel sends it to the cron endpoint automatically.
CRON_SECRET=
# Resend: notification emails. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Stripe (test keys first; live keys are refused unless STRIPE_ALLOW_LIVE=true)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=
# Random; its SHA-256 is stored in Supabase app_private.secrets ('billing_webhook')
BILLING_WEBHOOK_KEY=

# Random (openssl rand -hex 32); its SHA-256 is stored in Supabase app_private.secrets ('site_server').
# Authorizes the free first result, feedback and funnel counts.
SITE_SERVER_KEY=
# "true" turns on the free first result without an account. Keep unset until the Privacy Policy is published.
FREE_PREVIEW_ENABLED=

# Analytics (public; load only after the visitor consents)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
