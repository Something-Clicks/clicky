# Something Clicks environment variables.
# Copy to .env.local for local work. Never commit real values.
# On Vercel: Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are sent to the browser; everything else stays on the server.

# Site
NEXT_PUBLIC_SITE_URL=

# Supabase (public values: the publishable key only grants what RLS allows)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Server-only secrets (never NEXT_PUBLIC_) ──
# Model provider (owner decision Nov 27 2026): Groq is primary. Modal/self-hosted is deferred. OpenRouter is NOT enabled.
# Groq: set all four plus MARKETING_MODEL_PROVIDER=groq. Server-only; never NEXT_PUBLIC_; never in Production (the code refuses a model there).
# GROQ_API_KEY=               # console.groq.com; a key alone enables nothing
# GROQ_MODEL=                 # e.g. openai/gpt-oss-120b (strict structured output is documented for it); confirm with `pnpm modelcheck`
# GROQ_PRICE_INPUT_PER_MTOK=  # Groq's PUBLISHED paid rates for that model (groq.com/pricing), dollars per million tokens: a "shadow price"
# GROQ_PRICE_OUTPUT_PER_MTOK= #   so the app's dollar caps bind even on the free tier. Missing either = model unpriced = every call refused.
# GROQ_STRICT=0               # optional: best-effort schema mode for a model without strict support
# GROQ_REASONING_EFFORT=low   # optional: low | medium | high
# Marketing Agent feature testing (Preview and development only; ignored in Production):
# MARKETING_MODEL_PROVIDER=   # empty: no model. 'self-hosted' selects OUR model server (needs the three variables below).
# SELF_HOSTED_MODEL_URL=      # https address of the model server we operate (http only for localhost). No hosted AI provider.
# SELF_HOSTED_MODEL_TOKEN=    # that server's bearer token, 16+ characters; server-only secret
# SELF_HOSTED_MODEL_ID=       # the model name the server serves
# SELF_HOSTED_ATTEMPT_TIMEOUT_MS=  # optional, default 75000 (10000-600000)
# SELF_HOSTED_EXTRA_BODY=     # optional JSON merged into each request, e.g. a thinking switch the server understands
# SELF_HOSTED_PRICE_INPUT_PER_MTOK= / SELF_HOSTED_PRICE_OUTPUT_PER_MTOK=  # dollars per 1M tokens from MEASURED cost only; unset = unpriced = refused
# MODEL_USAGE_KEY=            # server-only; 32+ random characters. Its SHA-256 goes in app_private.secrets name 'model_usage'
# FEATURE_BUSINESS_PROFILE=1  # also FEATURE_MODEL_FINDINGS, FEATURE_DRAFTS, FEATURE_STRATEGY
# Google PageSpeed Insights API key (free). Without it Google's shared quota is often exhausted.
PAGESPEED_API_KEY=
# Weekly re-analysis worker (Vercel Cron). Secret key from Supabase → Project Settings → API Keys.
SUPABASE_SECRET_KEY=
# Long random string (openssl rand -hex 32). Vercel sends it to the cron endpoint automatically.
CRON_SECRET=
# Resend: notification emails. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Stripe (test keys first; live keys are refused unless STRIPE_ALLOW_LIVE=true)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=
# Random; its SHA-256 is stored in Supabase app_private.secrets ('billing_webhook')
BILLING_WEBHOOK_KEY=

# Random (openssl rand -hex 32); its SHA-256 is stored in Supabase app_private.secrets ('site_server').
# Authorizes the free first result, feedback and funnel counts.
SITE_SERVER_KEY=
# "true" turns on the free first result without an account. Keep unset until the Privacy Policy is published.
FREE_PREVIEW_ENABLED=

# Analytics (public; load only after the visitor consents)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
CLARITY_ID=              # server-only; Microsoft Clarity project id. Loads only after the visitor accepts analytics

# Trigger.dev (durable background jobs for the Marketing Agent; project proj_zkgvxkwwahbxpdtqspfe).
# Put the DEVELOPMENT secret key (Trigger.dev dashboard → API keys → Development) in .env.local only; never commit it.
TRIGGER_SECRET_KEY=
# "trigger" runs website checks and weekly re-checks as durable Trigger.dev jobs. Unset = in-process, as before.
# Ignored in Production (VERCEL_ENV=production) until the owner changes src/lib/server/agent/background.ts.
BACKGROUND_JOBS=
# The worker (src/trigger) also needs NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SECRET_KEY, MODEL_USAGE_KEY and the same
# FEATURE_* switches as the app: `trigger.dev dev` reads them from .env.local; deployed environments set them in Trigger.dev.
