# --- Supabase (Postgres, Auth, RLS). Apply supabase/migrations/*.sql to the project first. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only: the agent runs server-side and enforces roles itself

# --- Model provider (provider-neutral). Any OpenAI-compatible endpoint (hosted or self-hosted). ---
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# LLM_PROVIDER=mock                 # development/test only; refused in production

# --- Stripe (launch catalog only: Marketing Report + Marketing Assistant). Studio/Suite are planned and not sold. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MARKETING_REPORT=      # price id: $49 one-time
STRIPE_PRICE_MARKETING_ASSISTANT_MONTHLY=   # price id: $79 / month
STRIPE_PRICE_MARKETING_ASSISTANT_ANNUAL=    # price id: $756 / year

# --- Resend (transactional email) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
ANONYMOUS_PREVIEW_ENABLED=false     # keep false in production until the privacy policy is published
CRON_SECRET=                        # protects /api/jobs/run
IP_HASH_SALT=
# DEV_MODE=1                        # in-memory data + cookie auth. Local development/tests ONLY (refused in production)
