{
  "name": "something-clicks",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "icons": "node scripts/generate-icons.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "playwright test --trace off",
    "test:e2e": "E2E_SUITE=1 playwright test --trace off",
    "test:e2e:ui": "E2E_SUITE=1 playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:local": "bash e2e/run-local.sh",
    "sitecheck": "vitest run --project sitecheck --reporter verbose",
    "modelcheck": "vitest run --project modelcheck --reporter verbose evals/model/modelcheck.eval.ts",
    "modelscore": "vitest run --project modelcheck --reporter verbose evals/model/modelscore.eval.ts",
    "modelfreeze": "vitest run --project modelcheck --reporter verbose evals/model/freeze.eval.ts",
    "modelreview": "vitest run --project modelcheck --reporter verbose evals/model/review-packet.eval.ts",
    "trigger:dev": "trigger dev"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@microsoft/clarity": "^1.0.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@trigger.dev/sdk": "^4.8.10",
    "clsx": "2.1.1",
    "next": "16.4.6",
    "node-html-parser": "^9.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "stripe": "^23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@trigger.dev/build": "^4.8.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "pg": "^8.16.0",
    "sharp": "^0.35.5",
    "trigger.dev": "^4.8.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
